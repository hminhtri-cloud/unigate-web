{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ministry-source.js": { "regions": ["sin1"], "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/news-source", "destination": "/api/ministry-source" },
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
